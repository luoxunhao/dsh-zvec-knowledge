{
  "meta": {
    "name": "DSH 知识库插件设计令牌",
    "version": "1.0.0",
    "spec": "《DSH 知识库插件（基于 zvec）设计规范》v1.1.0 第 3 章（浅色）、第 7 章（深色）",
    "prefix": "--kb-",
    "themeSelectors": {
      "light": ":root",
      "dark": "body[data-ds-dark-theme]"
    },
    "namespaceNote": "所有令牌以 --kb- 前缀命名，避免与宿主 --dsw-* 令牌在同一份全局样式表作用域内碰撞。'specName' 记录设计规范中的原始令牌名，映射关系保持一一对应。",
    "conflicts": [
      {
        "token": "--kb-control-md",
        "issue": "设计规范 3.7 尺度令牌定义 controlMd = 32，但 4.1 按钮 md 尺寸、4.2 文本框高度、4.3 下拉与分段控件高度均为 34。",
        "resolution": "取 34。4.1/4.2/4.3 是组件的规范性定义且三处一致，3.7 为单处数值，按多数与组件基线对齐原则取值。",
        "action": "回写设计规范 v1.1.1 时需同步修正 3.7 或统一各控件高度。"
      },
      {
        "token": "--kb-border-subtle（顶栏分割线）",
        "issue": "设计规范 3.2 规定「分割线只使用 neutral-200 (#E1E5EC)」，但 6.1 顶栏使用 #E9ECF2（不在令牌表内），5.1 卡片内分隔线使用中性 100 (#EDEFF4)。",
        "resolution": "新增 --kb-divider-topbar (#E9ECF2) 与 --kb-divider-card (#EDEFF4) 两个具名令牌承载这两处实测值，不再视为裸色值。",
        "action": "回写设计规范 v1.1.1 时需二选一：把它们纳入令牌表，或把两处改回 neutral-200。"
      },
      {
        "token": "状态色描边（浅色）",
        "issue": "设计规范 3.3 只给出「实色 / 底纹 / 文字色」三列，缺浅色描边；而 2.3 设计原则 3 与 4.5 状态胶囊要求「文字 + 实色 + 描边」三件套，缺一违规。深色 7.4 提供了描边列。",
        "resolution": "浅色描边为派生值，取底纹与文字色之间的中间调，标记 derived = true。",
        "action": "待设计侧确认浅色五态描边取值后替换。"
      },
      {
        "token": "组件级尺寸未令牌化",
        "issue": "设计规范 3.7 的 Scale 令牌集（29 项）只覆盖间距、圆角、字号、控件高度与布局尺寸；标签高 26、胶囊 26/22、徽标 20、图标按钮 34×34、开关 38×22、进度条高 5、集合图标 38×38 等组件级尺寸均不在其中。",
        "resolution": "新增 component 令牌组承载这些尺寸，使「业务样式无裸尺寸」这条验收项可以达成，而不是被迫放宽。",
        "action": "回写设计规范 v1.1.1 时把 component 组纳入 Scale 令牌集，并同步画布变量面板。",
        "decided": "已拍板：确认扩充令牌集（不收敛回规范的 51 项）。KB-02 验收项「无自造令牌」按扩充后的 133 项集合重述，规范侧 3.x 需回写对齐。"
      },
      {
        "token": "--kb-text-quiet",
        "issue": "设计规范 4.6 指定选项卡未选态文字为 #5B6472，该值不在中性色阶内，且与「待构建」状态文字色相同，容易被当成状态色误用。",
        "resolution": "单列 --kb-text-quiet 令牌承载这一取值，与状态语义色区分开。",
        "action": "回写设计规范时二选一：纳入中性色阶，或改用 neutral-500（#6B7484）并接受轻微色差。"
      }
    ]
  },
