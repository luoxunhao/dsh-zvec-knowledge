{
  "name": "dsh-zvec-knowledge",
  "version": "0.1.0",
  "description": "DSH knowledge base plugin backed by the in-process zvec vector database: collections, document ingestion, chunking/embedding/index strategy, the dsh_kb_search tool, and cited RAG answers.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./scss": "./tokens/scss/_kb-tokens.scss",
    "./tokens.json": "./tokens/kb-tokens.json",
    "./tokens.w3c.json": "./tokens/w3c/kb-design-tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tokens/kb-tokens.json",
    "tokens/scss",
    "tokens/w3c",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "clean": "node scripts/clean-build.mjs",
    "prepack": "npm run build",
    "tokens": "node scripts/gen-tokens.mjs",
    "verify:tokens": "node scripts/gen-tokens.mjs --check",
    "verify:components": "node scripts/verify-components.mjs",
    "verify:kb10": "node scripts/verify-kb10.mjs",
    "verify:kb04kb05": "node scripts/verify-kb04-kb05.mjs",
    "verify:kb06": "node scripts/verify-kb06.mjs && node scripts/verify-kb06-cancel.mjs",
    "verify:kb07": "node scripts/verify-kb07.mjs",
    "verify:kb08": "node scripts/verify-kb08.mjs",
    "verify:embedding": "node scripts/verify-embedding.mjs",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "verify:quota": "node scripts/verify-kb11-quota.mjs",
    "verify:e2e": "node scripts/verify-e2e-retrieval.mjs",
    "verify:walkthrough": "node scripts/verify-kb11-walkthrough.mjs",
    "verify:slots": "node scripts/verify-harness-slots.mjs",
    "verify:spec": "node scripts/verify-spec-tokens.mjs && node scripts/verify-kb11-walkthrough.mjs",
    "verify:kb01": "node scripts/verify-kb01-profile.mjs",
    "verify:load-safety": "node scripts/verify-load-safety.mjs",
    "verify:bridge": "node scripts/verify-bridge.mjs",
    "verify:buildjob": "node scripts/verify-build-job.mjs",
    "verify:incremental": "node scripts/verify-incremental-build.mjs",
    "verify:retrieval": "node scripts/verify-retrieval-page.mjs",
    "verify:chunking": "node scripts/verify-chunking.mjs",
    "verify:layout": "node scripts/render-layout-check.mjs && node scripts/measure-layout.mjs && node scripts/measure-overflow.mjs",
    "verify:upload": "node scripts/verify-upload.mjs",
    "smoke:zvec": "node scripts/zvec-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "node scripts/clean-build.mjs && node scripts/gen-tokens.mjs && tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "test:kb10": "npm run build && node scripts/verify-kb10.mjs",
    "verify": "node scripts/gen-tokens.mjs --check && node scripts/verify-manifest.mjs && node scripts/verify-components.mjs && node scripts/verify-contrast.mjs && node scripts/verify-kb10.mjs && node scripts/verify-kb04-kb05.mjs && node scripts/verify-kb06.mjs && node scripts/verify-kb06-cancel.mjs && node scripts/verify-kb07.mjs && node scripts/verify-kb08.mjs && node scripts/verify-embedding.mjs && node scripts/verify-kb11-quota.mjs && node scripts/verify-harness-slots.mjs && node scripts/verify-spec-tokens.mjs && node scripts/verify-load-safety.mjs && node scripts/verify-bridge.mjs && node scripts/verify-build-job.mjs && node scripts/verify-incremental-build.mjs && node scripts/verify-retrieval-page.mjs && node scripts/verify-chunking.mjs && node scripts/render-layout-check.mjs && node scripts/measure-layout.mjs && node scripts/measure-overflow.mjs && node scripts/verify-upload.mjs && node scripts/verify-kb11-walkthrough.mjs"
  },
  "dependencies": {
    "@zvec/zvec": "^0.7.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1 || 0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3"
  }
}
