# Dependencies
node_modules/

# pnpm content-addressable store. A store is a local cache, never a source
# artifact — committing it both bloats the repo and leaks the absolute paths of
# whatever profiles happened to be installed.
.pnpm-store/

# Build output (plugin declares its own too; kept here for a single source of truth)
plugin/lib/
plugin/tmp/
plugin/zvec-smoke-report.json

# Scratch: harness homes, generated reports, one-off logs, source binaries
.workbuddy/tmp/

# The plugin's runtime store: the uploaded originals, the document log and the
# zvec snapshot directories. This is user data produced by running the plugin, not
# a source artifact — it is machine-specific, large, and contains whatever the user
# happened to upload. A fresh checkout creates it on first use.
.dsh-kb-zvec/

# Vision-tool artifacts (screenshots produced during visual walkthroughs). These
# are regenerable from `scripts/render-visual.mjs` and are not sources.
.dsh-vision-router/

# Pipeline intermediates. Excluded by CONTENTS rather than by directory, because
# a directory-level exclusion cannot be re-included by a later rule — git will
# not descend into an ignored directory to find the negation.
#
# The design spec's markdown SOURCE is deliberately kept: it is the authoritative
# text the `verify:spec` gate reads, so it is a source artifact, not an
# intermediate. The generated html/docx and the pipeline's working state are not.
output/*/*
!output/*/stage1/
output/*/stage1/*
!output/*/stage1/final_draft.md
